{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Terminal Reader",
  "version": "0.6.0",
  "identifier": "app.terminalreader.rewrite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Terminal Reader",
        "width": 560,
        "height": 400,
        "minWidth": 280,
        "minHeight": 160,
        "decorations": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#141619",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A terminal-style ebook reader",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": true,
        "installerHooks": "nsis/hooks.nsh"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "epub",
          "txt",
          "md",
          "markdown"
        ],
        "name": "Text and EPUB books",
        "role": "Viewer"
      }
    ]
  }
}
